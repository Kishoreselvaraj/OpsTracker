@{
    ViewData["Title"] = "Team Lead Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="/css/TL/TlDashboard.css" asp-append-version="true" />
}

<div class="tl-page">
    <!-- Header -->
    <header class="tl-header">
        <div class="tl-header-left">
            <div class="tl-greeting">Team Lead Portal</div>
            <h1 class="tl-title">Dashboard</h1>
            <div class="tl-subtitle">Manage team EODs and sub-groups</div>
        </div>
        <div class="tl-header-right">
            <div class="tl-user-badge">
                <span class="tl-user-role">Team Lead</span>
                <span class="tl-user-name">@ViewBag.TeamLeadName</span>
            </div>
        </div>
    </header>

    <!-- Tab Navigation -->
    <div class="tl-tabs">
        <button class="tl-tab active" data-tab="approval">
            <span>📋</span> EOD Approval
        </button>
        <button class="tl-tab" data-tab="team">
            <span>👥</span> My Team
        </button>
        <button class="tl-tab" data-tab="subgroups">
            <span>⚙️</span> Sub-Group Mgmt
        </button>
    </div>

    <!-- TAB 1: EOD Approval Queue -->
    <div class="tl-tab-content active" id="tab-approval">
        <!-- Stats Cards -->
        <div class="tl-stats-row">
            <div class="tl-stat-card pending">
                <div class="tl-stat-icon">⏳</div>
                <div class="tl-stat-info">
                    <div class="tl-stat-value" id="stat-pending">0</div>
                    <div class="tl-stat-label">Pending Review</div>
                </div>
            </div>
            <div class="tl-stat-card approved">
                <div class="tl-stat-icon">✅</div>
                <div class="tl-stat-info">
                    <div class="tl-stat-value" id="stat-approved">0</div>
                    <div class="tl-stat-label">Approved</div>
                </div>
            </div>
            <div class="tl-stat-card rejected">
                <div class="tl-stat-icon">❌</div>
                <div class="tl-stat-info">
                    <div class="tl-stat-value" id="stat-rejected">0</div>
                    <div class="tl-stat-label">Rejected</div>
                </div>
            </div>
            <div class="tl-stat-card correction">
                <div class="tl-stat-icon">📝</div>
                <div class="tl-stat-info">
                    <div class="tl-stat-value" id="stat-correction">0</div>
                    <div class="tl-stat-label">Need Correction</div>
                </div>
            </div>
        </div>

        <!-- Filters -->
        <div class="tl-filters">
            <div class="tl-filter-group">
                <button class="tl-filter-btn active" data-filter="today">Today</button>
                <button class="tl-filter-btn" data-filter="week">This Week</button>
                <button class="tl-filter-btn" data-filter="month">This Month</button>
                <button class="tl-filter-btn" data-filter="custom">Custom</button>
            </div>
            <div class="tl-filter-group">
                <select class="tl-filter-select" id="status-filter">
                    <option value="all">All Status</option>
                    <option value="PENDING">Pending</option>
                    <option value="APPROVED">Approved</option>
                    <option value="REJECTED">Rejected</option>
                    <option value="CORRECTION">Need Correction</option>
                </select>
            </div>
        </div>

        <!-- Approval Queue Table -->
        <div class="tl-table-container">
            <table class="tl-table" id="approval-queue">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>Date</th>
                        <th>Category</th>
                        <th>Sub-Group</th>
                        <th>Hours</th>
                        <th>Tasks</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody id="queue-body">
                    <!-- Populated by JS -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 2: My Team -->
    <div class="tl-tab-content" id="tab-team">
        <div class="tl-team-header">
            <h3>Team Members</h3>
            <span class="tl-team-count" id="team-count">0 members</span>
        </div>
        <div class="tl-team-grid" id="team-grid">
            <!-- Populated by JS -->
        </div>
    </div>

    <!-- TAB 3: Sub-Group Management -->
    <div class="tl-tab-content" id="tab-subgroups">
        <div class="tl-subgroup-header">
            <div>
                <h3>Task Group: <span id="task-group-name">India</span></h3>
                <p class="tl-subgroup-subtitle">Manage sub-groups and assign members</p>
            </div>
            <button class="btn-gold" id="btn-create-subgroup">
                <span>+</span> Create Sub-Group
            </button>
        </div>

        <!-- Create Sub-Group Form (hidden by default) -->
        <div class="tl-create-form" id="create-subgroup-form" style="display:none;">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Sub-Group Name</label>
                    <input type="text" class="form-input" id="subgroup-name" placeholder="e.g., Backend Development" />
                </div>
                <div class="form-group">
                    <label class="form-label">Description</label>
                    <input type="text" class="form-input" id="subgroup-desc" placeholder="Optional description" />
                </div>
            </div>
            <div class="tl-create-actions">
                <button class="btn-outline btn-sm" id="btn-cancel-create">Cancel</button>
                <button class="btn-gold btn-sm" id="btn-save-subgroup">✓ Create</button>
            </div>
        </div>

        <!-- Sub-Groups Grid -->
        <div class="tl-subgroup-grid" id="subgroup-grid">
            <!-- Populated by JS -->
        </div>
    </div>
</div>

<!-- EOD Review Modal -->
<div class="modal-overlay" id="review-modal">
    <div class="modal-panel modal-lg">
        <button class="modal-close" id="review-modal-close">×</button>
        
        <div class="modal-title" id="review-member-name">Rahul Kumar</div>
        <div class="modal-subtitle" id="review-date">EOD for May 14, 2026</div>

        <!-- Member Info -->
        <div class="tl-review-meta">
            <span>📁 <span id="review-category">Development</span></span>
            <span>🏷️ <span id="review-subgroup">Backend</span></span>
            <span>⏱️ <span id="review-hours">8.5h</span> total</span>
        </div>

        <!-- EOD Entries -->
        <div class="entries-section">
            <div class="entries-header">
                <span class="entries-title">📋 Work Entries</span>
                <span class="entries-count" id="review-entry-count">3 entries</span>
            </div>
            <div class="entries-list" id="review-entries">
                <!-- Populated by JS -->
            </div>
        </div>

        <!-- Approval Actions -->
        <div class="tl-approval-actions" id="approval-actions">
            <div class="form-group">
                <label class="form-label">Comments / Reason (required for Reject/Correction)</label>
                <textarea class="form-textarea" id="approval-comment" placeholder="Enter your feedback..."></textarea>
            </div>
            <div class="tl-action-btns">
                <button class="btn-danger" id="btn-reject">
                    <span>❌</span> Reject
                </button>
                <button class="btn-warning" id="btn-correction">
                    <span>📝</span> Need Correction
                </button>
                <button class="btn-success" id="btn-approve">
                    <span>✅</span> Approve
                </button>
            </div>
        </div>

        <!-- Read-only view for already actioned -->
        <div class="tl-actioned-view" id="actioned-view" style="display:none;">
            <div class="tl-actioned-status" id="actioned-status">
                Approved by Priya S. on May 14, 2026 at 6:30 PM
            </div>
            <div class="tl-actioned-comment" id="actioned-comment">
                Great work on the API integration!
            </div>
        </div>

        <div class="modal-actions">
            <button class="btn-outline" id="btn-close-review">Close</button>
        </div>
    </div>
</div>

<!-- Sub-Group Member Management Modal -->
<div class="modal-overlay" id="subgroup-modal">
    <div class="modal-panel">
        <button class="modal-close" id="subgroup-modal-close">×</button>
        
        <div class="modal-title" id="subgroup-modal-title">Manage QA Members</div>
        <div class="modal-subtitle">Assign or remove members from this sub-group</div>

        <div class="tl-member-assign">
            <div class="tl-assign-section">
                <h4>Available Members</h4>
                <div class="tl-assign-list" id="available-members">
                    <!-- Populated by JS -->
                </div>
            </div>
            <div class="tl-assign-divider">
                <button class="btn-gold btn-sm" id="btn-add-members">→</button>
                <button class="btn-outline btn-sm" id="btn-remove-members">←</button>
            </div>
            <div class="tl-assign-section">
                <h4>Assigned Members</h4>
                <div class="tl-assign-list" id="assigned-members">
                    <!-- Populated by JS -->
                </div>
            </div>
        </div>

        <div class="modal-actions">
            <button class="btn-outline" id="btn-cancel-subgroup">Cancel</button>
            <button class="btn-gold" id="btn-save-members">✓ Save Changes</button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="/js/TL/TlDashboard.js" asp-append-version="true"></script>
}