@{
    ViewData["Title"] = "Team Lead Dashboard";
}

@section Styles {
    <link rel="stylesheet" href="/css/TL/tl-dashboard.css" asp-append-version="true" />
}

<div class="tl-page">

    <!-- Top Navigation -->
    <nav class="tl-nav">
        <div class="tl-nav-brand">
            <span class="tl-nav-logo">◆</span>
            <span class="tl-nav-title">OpsTracker</span>
        </div>
        <div class="tl-nav-links">
            <a href="/tl/dashboard" class="tl-nav-link active">Dashboard</a>
            <a href="/tl/approvals" class="tl-nav-link">Approvals</a>
            <a href="/tl/team" class="tl-nav-link">Team Members</a>
            <a href="/tl/groups" class="tl-nav-link">Sub-Groups</a>
        </div>
        <div class="tl-nav-user">
            <span class="tl-nav-role">Team Lead</span>
            <span class="tl-nav-name" id="nav-user-name">Loading...</span>
        </div>
    </nav>

    <!-- Page Header -->
    <header class="tl-header">
        <div class="tl-header-left">
            <div class="tl-greeting" id="tl-greeting">Good Morning</div>
            <h1 class="tl-title">Dashboard</h1>
            <div class="tl-subtitle">Overview of team activity and pending actions</div>
        </div>
        <div class="tl-header-right">
            <div class="tl-date-badge">
                <span id="current-date">May 21, 2026</span>
            </div>
        </div>
    </header>

    <!-- Critical Alerts Banner -->
    <div class="alerts-container" id="alerts-container">
        <!-- Populated by JS -->
    </div>

    <!-- Stats Overview -->
    <div class="stats-section">
        <div class="stats-grid">
            <div class="stat-card pending" data-filter="PENDING">
                <div class="stat-icon">⏳</div>
                <div class="stat-info">
                    <div class="stat-value" id="stat-pending">0</div>
                    <div class="stat-label">Pending Review</div>
                </div>
                <div class="stat-glow"></div>
            </div>
            <div class="stat-card approved" data-filter="APPROVED">
                <div class="stat-icon">✓</div>
                <div class="stat-info">
                    <div class="stat-value" id="stat-approved">0</div>
                    <div class="stat-label">Approved (MTD)</div>
                </div>
                <div class="stat-glow"></div>
            </div>
            <div class="stat-card rejected" data-filter="REJECTED">
                <div class="stat-icon">✕</div>
                <div class="stat-info">
                    <div class="stat-value" id="stat-rejected">0</div>
                    <div class="stat-label">Rejected (MTD)</div>
                </div>
                <div class="stat-glow"></div>
            </div>
            <div class="stat-card correction" data-filter="CORRECTION">
                <div class="stat-icon">↻</div>
                <div class="stat-info">
                    <div class="stat-value" id="stat-correction">0</div>
                    <div class="stat-label">Need Correction</div>
                </div>
                <div class="stat-glow"></div>
            </div>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="dashboard-grid">
        
        <!-- Left: Today's Snapshot -->
        <div class="dashboard-left">
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Today's Submissions</span>
                    <a href="/tl/approvals" class="panel-link">View All →</a>
                </div>
                <div class="panel-body">
                    <div class="snapshot-table-container">
                        <table class="snapshot-table" id="snapshot-table">
                            <thead>
                                <tr>
                                    <th>Member</th>
                                    <th>Hours</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody id="snapshot-body">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                    <div class="snapshot-empty" id="snapshot-empty" style="display:none;">
                        <div class="empty-icon">◌</div>
                        <div class="empty-text">No submissions yet today</div>
                    </div>
                </div>
            </div>

            <!-- Weekly Trend -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Weekly Trend</span>
                    <span class="panel-subtitle">Last 7 days</span>
                </div>
                <div class="panel-body">
                    <div class="trend-chart" id="trend-chart">
                        <!-- CSS-only bars populated by JS -->
                    </div>
                    <div class="trend-legend">
                        <span class="trend-legend-item">
                            <span class="trend-dot submitted"></span> Submitted
                        </span>
                        <span class="trend-legend-item">
                            <span class="trend-dot pending"></span> Pending
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Team Pulse -->
        <div class="dashboard-right">
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Team Pulse</span>
                    <span class="panel-subtitle" id="team-pulse-count">0 members</span>
                </div>
                <div class="panel-body">
                    <div class="pulse-list" id="pulse-list">
                        <!-- Populated by JS -->
                    </div>
                </div>
            </div>

            <!-- Quick Actions -->
            <div class="panel">
                <div class="panel-header">
                    <span class="panel-title">Quick Actions</span>
                </div>
                <div class="panel-body">
                    <div class="quick-actions">
                        <a href="/tl/approvals" class="quick-action">
                            <span class="quick-action-icon">📋</span>
                            <span class="quick-action-text">Review Pending EODs</span>
                            <span class="quick-action-badge" id="quick-pending">0</span>
                        </a>
                        <a href="/tl/team" class="quick-action">
                            <span class="quick-action-icon">👥</span>
                            <span class="quick-action-text">View Team Directory</span>
                        </a>
                        <a href="/tl/groups" class="quick-action">
                            <span class="quick-action-icon">⚙️</span>
                            <span class="quick-action-text">Manage Sub-Groups</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script type="module" src="/js/TL/tl-dashboard.js" asp-append-version="true"></script>
}