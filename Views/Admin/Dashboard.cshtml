@{
    ViewData["Title"] = "Admin Dashboard";
}
<div class="page-hero">
    <h1>Administration</h1>
    <p class="lead">Full system access — organizations, users, settings, and cross-department oversight.</p>
</div>

<div class="stat-grid-premium">
    <div class="stat-tile">
        <div class="stat-tile-label">Scope</div>
        <div class="stat-tile-value">Global</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-label">Organizations</div>
        <div class="stat-tile-value" id="admin-stat-orgs">—</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-label">Users</div>
        <div class="stat-tile-value" id="admin-stat-users">—</div>
    </div>
    <div class="stat-tile">
        <div class="stat-tile-label">Settings</div>
        <div class="stat-tile-value"><i class="fa-solid fa-sliders" style="font-size:1.2rem"></i></div>
    </div>
</div>

<div class="ops-card ops-card--accent">
    <h2 class="h5 mb-2" style="color:var(--gold-2)">Quick actions</h2>
    <p class="text-secondary mb-0">Manage the platform structure and configuration.</p>
    <div class="quick-actions">
        <a class="btn-gold-gradient" href="/Admin/Departments"><i class="fa-solid fa-building"></i> Departments</a>
        <a class="btn-gold-outline" href="/Admin/Organizations"><i class="fa-solid fa-sitemap"></i> Organizations</a>
        <a class="btn-gold-outline" href="/Admin/Users"><i class="fa-solid fa-users"></i> Users</a>
        <a class="btn-gold-outline" href="/Admin/Settings"><i class="fa-solid fa-gear"></i> System settings</a>
        <a class="btn-gold-outline" href="/DeptHead/Reports"><i class="fa-solid fa-chart-column"></i> Reports</a>
        <a class="btn-gold-outline" href="/DeptHead/Dashboard"><i class="fa-solid fa-building"></i> Department tools</a>
    </div>
</div>

<script type="module">
    import { requireAuth } from '/js/auth/routeGuard.js';
    import { apiGet, unwrap } from '/js/services/apiClient.js';

    if (!requireAuth({ allowRoles: ['Admin'] })) throw new Error('auth');

    async function loadStats() {
        try {
            const orgJson = await apiGet('/api/Organization/list');
            const { data: orgs } = unwrap(orgJson);
            document.getElementById('admin-stat-orgs').textContent = Array.isArray(orgs) ? orgs.length : '0';
        } catch {
            document.getElementById('admin-stat-orgs').textContent = '—';
        }
    }
    loadStats();
</script>
