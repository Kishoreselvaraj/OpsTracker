@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpsTracker</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/hierarchy.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OpsTracker_v1.styles.css" asp-append-version="true" />
    <script>
        window.__OPSTRACKER_CONFIG = {
            apiBaseUrl: '@(Configuration["ApiBaseUrl"] ?? "https://localhost:7181")'
        };
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="app-shell d-flex flex-column min-vh-100">
    <div class="sidebar-backdrop" id="sidebar-backdrop" aria-hidden="true"></div>

    <div class="app-layout">
        <aside class="app-sidebar" id="app-sidebar" aria-label="Main navigation">
            <div class="sidebar-brand">
                <a asp-controller="Login" asp-action="Index">
                    <span class="sidebar-logo">OT</span>
                    <span class="sidebar-brand-text">OpsTracker</span>
                </a>
            </div>
            <div class="sidebar-role-badge" id="sidebar-role-badge">Member</div>
            <nav class="sidebar-nav" id="sidebar-nav" aria-label="Role menu"></nav>
            <div class="sidebar-footer nav-auth-only d-none">
                <a href="#" class="sidebar-link" id="btn-logout-sidebar">
                    <i class="fa-solid fa-right-from-bracket"></i><span>Sign out</span>
                </a>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="sidebar-toggle" id="sidebar-toggle" aria-label="Open menu">
                        <i class="fa-solid fa-bars"></i>
                    </button>
                    <span class="topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="topbar-actions nav-auth-only d-none">
                    <div class="nav-notif-wrap">
                        <button type="button" class="nav-notif-btn" id="nav-notif-btn" title="Notifications" aria-label="Notifications">
                            <i class="fa-regular fa-bell"></i>
                        </button>
                        <span class="nav-notif-badge" id="nav-notif-badge"></span>
                        <div class="nav-notif-panel" id="nav-notif-panel"></div>
                    </div>
                    <span class="nav-user-name" id="nav-user-display"></span>
                    <button type="button" class="btn-ghost" id="btn-logout">Logout</button>
                </div>
                <div class="nav-guest-only">
                    <a class="btn-gold-outline" asp-controller="Login" asp-action="Index">Sign in</a>
                </div>
            </header>

            <div class="app-content">
                <main role="main">@RenderBody()</main>
            </div>

            <footer class="app-footer">
                &copy; 2026 Aetram OpsTracker
            </footer>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="~/js/shared/layoutInit.js" asp-append-version="true"></script>
    <script type="module">
        import { bindLogout } from '/js/auth/routeGuard.js';
        bindLogout('#btn-logout-sidebar');
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
