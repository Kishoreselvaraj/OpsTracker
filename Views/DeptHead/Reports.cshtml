@{
    ViewData["Title"] = "Reports";
}
<div class="page-hero">
    <h1>Department reports</h1>
    <p class="lead">Summary metrics for your department.</p>
</div>
<div class="ops-card">
    <button type="button" class="btn-gold-gradient mb-3" id="btn-load-report">Load department summary</button>
    <div id="report-out"><p class="text-secondary mb-0">Click load to fetch report data.</p></div>
</div>
<script type="module">
    import { requireAuth } from '/js/auth/routeGuard.js';
    import { apiPost, unwrap } from '/js/services/apiClient.js';
    if (!requireAuth({ allowRoles: ['DepartmentHead', 'Admin'] })) throw new Error('auth');

    document.getElementById('btn-load-report').addEventListener('click', async () => {
        const out = document.getElementById('report-out');
        out.innerHTML = '<p class="text-secondary">Loading…</p>';
        try {
            const json = await apiPost('/api/Report/department-summary', {
                fromDate: null,
                toDate: null
            });
            const { data } = unwrap(json);
            const rows = Array.isArray(data) ? data : [];
            out.innerHTML = rows.length
                ? rows.map(r => `<div class="py-3 border-bottom" style="border-color:var(--border-subtle)!important">
                    <strong style="color:var(--gold-2)">${r.departmentName ?? r.DepartmentName}</strong>
                    <div class="text-secondary small mt-1">Teams: ${r.totalTeams ?? 0} · Members: ${r.totalMembers ?? 0} · EODs submitted: ${r.submittedEods ?? 0}</div>
                </div>`).join('')
                : '<p class="text-secondary mb-0">No report rows.</p>';
        } catch (e) {
            out.innerHTML = `<p class="text-danger">${e.message || 'Failed'}</p>`;
        }
    });
</script>
