@{
    ViewData["Title"] = "Teams";
}
@section Styles {
    <link rel="stylesheet" href="~/css/hierarchy.css" asp-append-version="true" />
}

<nav id="hierarchy-breadcrumbs" class="hierarchy-bc" aria-label="Breadcrumb"></nav>

<div class="page-hero">
    <h1>Teams</h1>
    <p class="lead">Create teams under task groups and assign team leads and members.</p>
</div>

<div class="hierarchy-toolbar">
    <a href="/DeptHead/Groups" class="btn-gold-outline btn-sm"><i class="fa-solid fa-arrow-left"></i> Groups</a>
    <button type="button" class="btn-gold-gradient" id="btn-team-create" data-require-role="DepartmentHead,Admin">
        <i class="fa-solid fa-plus"></i> New team
    </button>
</div>

<div class="ops-card hierarchy-table-wrap">
    <table class="hierarchy-table">
        <thead>
            <tr>
                <th>Team</th>
                <th>Group</th>
                <th>Team lead</th>
                <th>Code</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody id="team-table-body">
            <tr><td colspan="5" class="text-secondary">Loading…</td></tr>
        </tbody>
    </table>
</div>

<div class="modal fade" id="team-modal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content ops-modal">
            <form id="team-form">
                <div class="modal-header border-0">
                    <h5 class="modal-title">Team</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" for="team-group-id">Task group</label>
                            <select class="form-select" id="team-group-id" required></select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="team-code">Code</label>
                            <input class="form-control" id="team-code" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="team-name">Team name</label>
                            <input class="form-control" id="team-name" required />
                        </div>
                        <div class="col-12">
                            <label class="form-label" for="team-desc">Description</label>
                            <textarea class="form-control" id="team-desc" rows="2"></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" for="team-lead-id">Team lead</label>
                            <select class="form-select" id="team-lead-id"></select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">Team members (from your department)</label>
                            <div class="member-chip-list" id="team-members"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn-gold-outline" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn-gold-gradient">Save team</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script type="module" src="~/js/pages/depthead-teams.js" asp-append-version="true"></script>
