{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=EOD;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "DataAccess": {
    "CommandTimeoutSeconds": 30
  },
  "Authentication": {
    "DefaultRedirectPath": "/Dashboard",
    "DefaultPostRegisterRedirectPath": "/Login",
    "Pbkdf2Iterations": 100000,
    "Pbkdf2KeyBytes": 32
  }
}