@{
    Layout = null;
}
<link rel="stylesheet" href="/css/login.css" />
<body>
    <!-- Animated Background -->
    <div class="glow-bg" aria-hidden="true">
        <div class="glow-orb glow-orb-1"></div>
        <div class="glow-orb glow-orb-2"></div>
    </div>

    <!-- Login Card -->
    <div class="login-card pr-3 pl-3`">
        <div class="card-header-custom">
            <h1 class="tittle-head h3">Welcome Back</h1>
            <p class="subtitle">Sign in to your account to continue</p>
        </div>

        <form id="loginForm" class="needs-validation" novalidate autocomplete="off">
            <!-- Username -->
            <div class="mb-3">
                <label class="label-tittle" for="username">Username</label>
                <div class="input-group-custom">
                    <i class="fa-solid fa-user input-icon" aria-hidden="true"></i>
                    <input 
                        type="text" 
                        id="username" 
                        name="username" 
                        class="form-control ekyc-input-field" 
                        placeholder="Enter your username"
                        autocomplete="username"
                        required
                    >
                    <span class="validation-message" id="usernameError"></span>
                </div>
            </div>

            <!-- Password -->
            <div class="mb-1">
                <label class="label-tittle" for="passwordInput">Password</label>
                <div class="input-group-custom">
                    <i class="fa-solid fa-lock input-icon" aria-hidden="true"></i>
                    <input 
                        type="password" 
                        id="passwordInput" 
                        name="password" 
                        class="form-control ekyc-input-field" 
                        placeholder="Enter your password"
                        autocomplete="current-password"
                        required
                        minlength="6"
                    >
                    <span class="validation-message" id="passwordError"></span>
                    <button 
                        type="button" 
                        class="toggle-password" 
                        id="togglePassword"
                        aria-label="Show password"
                        aria-pressed="false"
                    >
                        <i class="fa-solid fa-eye-slash" aria-hidden="true"></i>
                    </button>
                    <div class="invalid-feedback">Password must be at least 6 characters.</div>
                </div>
            </div>

            <!-- Remember & Forgot -->
            <div class="extras-row">
                <label class="remember-me">
                    <input type="checkbox" name="remember" id="rememberCheck">
                    <span>Remember me</span> 
                </label>
                <a href="#" class="forgot-link">Forgot password?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn btn-gold" id="loginBtn">
                <span id="btnText">Sign In</span>
                <span id="btnLoader" class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
            </button>
            <div id="loginError" class="error-message"></div>
        </form>

        <div class="divider">
            <span>or</span>
        </div>

        <p class="signup-text">
            Don't have an account? <a href="#">Create one</a>
        </p>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script type="module" src="/js/auth/login.js"></script>
</body>


