@{
    ViewData["Title"] = "EOD Submission";
}

@section Styles {
    <link rel="stylesheet" href="/css/EodCalander.css" asp-append-version="true" />
}

<div class="eod-page">

    <header class="eod-header" id="eod-analytics-header">
        <div class="analytics-container">
            <div class="analytics-card skeleton" style="height: 80px"></div>
            <div class="analytics-card skeleton" style="height: 80px"></div>
            <div class="analytics-card skeleton" style="height: 80px"></div>
        </div>
    </header>

    <div class="calendar-container">
        <div class="cal-header">
            <div class="cal-month-year" id="cal-month-year">May 2026</div>

            <div class="cal-nav-group">
                <div class="cal-nav-btns">
                    <button class="cal-nav-btn" id="btn-prev-month" title="Previous">‹</button>
                    <button class="cal-nav-btn" id="btn-next-month" title="Next">›</button>
                </div>
            </div>
        </div>

        <div class="cal-weekdays">
            <div class="cal-weekday">Mon</div>
            <div class="cal-weekday">Tue</div>
            <div class="cal-weekday">Wed</div>
            <div class="cal-weekday">Thu</div>
            <div class="cal-weekday">Fri</div>
            <div class="cal-weekday">Sat</div>
            <div class="cal-weekday">Sun</div>
        </div>

        <div class="cal-grid" id="cal-grid">
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
            <div class="cal-day skeleton" style="height:160px"></div>
        </div>
    </div>

</div>

<!-- Modal: Fixed Layout (Header + Scrollable Body + Fixed Footer) -->
<div class="modal-overlay" id="eod-modal">
    <div class="modal-panel">

        <!-- Fixed Header -->
        <div class="modal-header">
            <button class="modal-close" id="modal-close">×</button>
            <div class="modal-title" id="modal-date">Thursday, 14 May 2026</div>
            <div class="modal-subtitle" id="modal-date-short">2026-05-14</div>
        </div>

        <!-- Scrollable Body -->
        <div class="modal-body">
            <!-- Existing Entries Section -->
            <div class="entries-section">
                <div class="entries-header">
                    <span class="entries-title">Entries</span>
                    <span class="entries-count" id="entries-count">0 entries</span>
                </div>
                <div class="entries-list" id="entries-list">
                    <div style="text-align:center;padding:28px 0;color:var(--text-3);font-size:13px">
                        Loading...
                    </div>
                </div>
            </div>

            <!-- New Entry Trigger -->
            <div style="text-align:center; margin: 12px 0;">
                <button class="btn-gold" id="btn-show-form">
                    + New Entry
                </button>
            </div>

            <!-- Multi-row Draft Form -->
            <div id="new-entry-form">
                <div class="form-section-title" id="form-title">New Entry</div>
                <input type="hidden" id="workDate" />
                <div class="draft-rows-container" id="draft-rows-container"></div>
                <button type="button" class="btn-add-row" id="btn-add-row">
                    + Add Log
                </button>
            </div>
        </div>

        <!-- Fixed Footer (Always Visible) -->
        <div class="modal-footer">
            <div class="modal-actions">
                <div class="modal-actions-left">
                    <!-- Left section kept empty for layout balance -->
                </div>
                <div class="modal-actions-right">
                    <button class="btn-outline" id="btn-pull-yesterday" style="display:none;">
                        Pull Tasks
                    </button>
                    <button class="btn-submit-eod" id="btn-submit-eod" style="display:none;">
                        Submit
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
    <script type="module" src="/js/EodCalander.js" asp-append-version="true"></script>
}